# OpenAI API配置
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-api-key-here

# 可选: 自定义API基础地址 (如使用代理或兼容OpenAI的服务)
# OPENAI_BASE_URL=https://api.openai.com/v1

# STT模型: whisper-1
STT_MODEL=whisper-1

# 翻译模型: gpt-4o-mini (速度快且性价比高)
TRANSLATION_MODEL=gpt-4o-mini

# 源语言 (ISO 639-1代码)
SOURCE_LANG=en

# 目标语言
TARGET_LANG=zh

# 服务器端口
PORT=3000

# WebSocket最大消息大小 (bytes)
WS_MAX_PAYLOAD=1048576
