# AI同声传译 - 环境变量配置
#
# 方案A (推荐): DeepSeek 翻译 + 浏览器端语音识别
#   - 语音识别: 浏览器 Web Speech API (无需Key)
#   - 翻译: DeepSeek Chat API
#   配置 OPENAI_BASE_URL=https://api.deepseek.com/v1
#         OPENAI_API_KEY=sk-你的DeepSeekKey
#         TRANSLATION_MODEL=deepseek-chat
#         STT_ENGINE=browser
#
# 方案B: 完全使用 OpenAI
#   - 配置 OPENAI_API_KEY=sk-你的OpenAIKey
#   - 默认使用 Whisper STT + GPT 翻译

# DeepSeek / OpenAI API Key
OPENAI_API_KEY=sk-your-api-key-here

# API 基础地址 (DeepSeek: https://api.deepseek.com/v1, OpenAI: https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 语音识别引擎: browser (浏览器Web Speech API) 或 whisper (OpenAI Whisper)
STT_ENGINE=browser

# 翻译模型 (DeepSeek: deepseek-chat, OpenAI: gpt-4o-mini)
TRANSLATION_MODEL=deepseek-chat

# 源语言 (ISO 639-1代码)
SOURCE_LANG=en

# 目标语言
TARGET_LANG=zh

# 服务端口
PORT=3000
